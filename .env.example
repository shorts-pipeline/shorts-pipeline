# API keys for Lewis & Clark video pipeline
# Copy to .env and fill in your keys:
#   cp .env.example .env
# Loaded by python-dotenv when running scripts.

# Required for generate-narration-two-phase.py (default narration backend: Claude)
ANTHROPIC_API_KEY=

# Required for OpenAI TTS and for --llm-provider openai (narration backend fallback)
OPENAI_API_KEY=

# Required for narration-to-video.py --vendor google (Google Veo)
GOOGLE_API_KEY=

# Required for narration-to-video.py --vendor fal (fal.ai Wan)
FAL_KEY=

# Optional: set to 1 or true to allow video API calls without --yes flag.
# Use for cron/automation. Leave unset for interactive runs.
# ALLOW_VIDEO_API=

# Optional: pipeline_ui/server.py bind host (default 127.0.0.1, localhost-only).
# Set to 0.0.0.0 to reach the UI from another device, e.g. over Tailscale.
# PIPELINE_UI_HOST=0.0.0.0

# Required for instagram_upload.py. Create an app at
# https://developers.facebook.com/apps with the "Instagram API with Instagram
# Login" product added, on an Instagram Professional (Business/Creator)
# account. IG_USER_ID is printed by `instagram_upload.py --login-only` the
# first time you run it. See instagram_upload.py's module docstring.
# IG_APP_ID=
# IG_APP_SECRET=
# IG_USER_ID=
# IG_REDIRECT_URI=https://localhost/instagram/callback

# Optional overrides for instagram_upload.py's S3 staging step (Instagram's
# API fetches the video from a public URL; defaults reuse the same bucket/
# profile/region as scripts/backup_archive_to_s3.py under a social_staging/
# prefix). Only needed if you want social uploads staged somewhere else.
# IG_S3_BUCKET=
# IG_S3_PROFILE=
# IG_S3_REGION=
# IG_GRAPH_API_BASE=https://graph.instagram.com/v21.0

# Optional: load prompt packs from a directory outside the repo (absolute, ~, or
# repo-relative). Default is ./prompt_packs. Lets a private pack repo be shared
# across projects without being committed here.
# PROMPT_PACKS_DIR=
